@model MalapadCogonEConcern.ViewModels.ReportFilterViewModel
@using MalapadCogonEConcern.Models.Enums
@{
    ViewData["Title"] = "Barangay Concern Analytics & Reports";
}

<style>
    @@media print {
        header, footer, .no-print, .btn, .navbar, form, .marikina-sidebar, .marikina-top-blue-band {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        body {
            background-color: #ffffff !important;
            color: #000000 !important;
        }
        .card, .marikina-table-card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
        }
        .col-lg-9 {
            width: 100% !important;
        }
        .marikina-page-wrapper {
            padding: 0 !important;
        }
    }
    .print-only {
        display: none;
    }
</style>

<div class="marikina-page-wrapper position-relative">
    <!-- Signature Marikina Curved Blue Top Band -->
    <div class="marikina-top-blue-band no-print"></div>

    <div class="container-fluid px-lg-5 marikina-main-content">
        <!-- Official Print Header (Only visible when printing) -->
        <div class="print-only text-center mb-4">
            <h6 class="mb-0 text-uppercase">Republic of the Philippines</h6>
            <h6 class="mb-0 text-uppercase">Province of Capiz &bull; Municipality of Sigma</h6>
            <h4 class="fw-bold text-uppercase mt-1 mb-1">Barangay Malapad, Cogon</h4>
            <div class="fw-bold border-bottom pb-2">COMMUNITY CONCERNS &amp; ACTION SUMMARY REPORT</div>
            <small class="text-muted d-block mt-1">Generated: @DateTime.UtcNow.ToLocalTime().ToString("MMMM dd, yyyy hh:mm tt")</small>
        </div>

        <div class="row g-4">
            <!-- LEFT: Floating Sidebar (Docked at Top-Left) -->
            <div class="col-lg-3 col-md-4 no-print">
                <partial name="_MarikinaSidebar" model='"CouncilReports"' />
            </div>

            <!-- RIGHT: Council Reports & Community Analytics -->
            <div class="col-lg-9 col-md-8">
                <!-- Header in Blue Hero Section -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 no-print">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white brand-blue-text fw-bold text-uppercase px-2 py-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                <i class="bi bi-file-earmark-bar-graph me-1"></i> Council Analytics
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-0 text-uppercase" style="letter-spacing: 0.5px;">
                            Reports &amp; Community Analytics
                        </h3>
                        <small class="text-white-50 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">
                            Generate council summaries, analyze recurring issues, and export data
                        </small>
                    </div>
                    <div class="d-flex gap-2 mt-3 mt-md-0">
                        <a asp-action="ExportCsv" 
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-sitioId="@Model.SitioId"
                           class="btn btn-light brand-blue-text fw-bold btn-sm shadow-sm px-3 py-2">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV / Excel
                        </a>
                        <button class="btn btn-marikina-orange btn-sm fw-bold shadow-sm px-3 py-2" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> Print Council Report
                        </button>
                    </div>
                </div>

                <!-- Filter Form Card -->
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-4 no-print">
                    <form method="get" asp-action="Index" class="row g-3 align-items-end">
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label small fw-bold text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.4px;">Start Date</label>
                            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3" />
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label class="form-label small fw-bold text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.4px;">End Date</label>
                            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3" />
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label class="form-label small fw-bold text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.4px;">Category</label>
                            <select name="categoryId" class="form-select form-select-sm rounded-3">
                                <option value="">-- All Categories --</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 col-sm-6">
                            <label class="form-label small fw-bold text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.4px;">Sitio / Purok</label>
                            <select name="sitioId" class="form-select form-select-sm rounded-3">
                                <option value="">-- All Sitios --</option>
                                @foreach (var s in Model.Sitios)
                                {
                                    <option value="@s.Id" selected="@(Model.SitioId == s.Id)">@s.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-1 d-grid">
                            <button type="submit" class="btn btn-marikina-blue btn-sm fw-bold">
                                <i class="bi bi-funnel"></i> Apply
                            </button>
                        </div>
                    </form>
                </div>

                <!-- KPI Metric Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #0b5791;">
                            <div class="kpi-label">Total Received</div>
                            <div class="kpi-num brand-blue-text">@Model.TotalReceived</div>
                            <div class="kpi-sub">In selected period</div>
                        </div>
                    </div>

                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #059669;">
                            <div class="kpi-label">Resolved</div>
                            <div class="kpi-num text-success">@Model.TotalResolved</div>
                            <div class="kpi-sub text-success fw-bold">@Model.ResolutionRate% Rate</div>
                        </div>
                    </div>

                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #eb5722;">
                            <div class="kpi-label">Pending / Action</div>
                            <div class="kpi-num brand-orange-text">@Model.TotalPending</div>
                            <div class="kpi-sub">Under active response</div>
                        </div>
                    </div>

                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #7c3aed;">
                            <div class="kpi-label">Forwarded</div>
                            <div class="kpi-num" style="color: #7c3aed;">@Model.TotalForwarded</div>
                            <div class="kpi-sub">External agencies</div>
                        </div>
                    </div>

                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #dc2626;">
                            <div class="kpi-label">Rejected / Invalid</div>
                            <div class="kpi-num text-danger">@Model.TotalRejected</div>
                            <div class="kpi-sub">Documented misuse</div>
                        </div>
                    </div>

                    <div class="col-md-2 col-sm-4 col-6">
                        <div class="marikina-kpi-card text-center" style="border-top: 4px solid #009fe3;">
                            <div class="kpi-label">Avg. Resolution</div>
                            <div class="kpi-num" style="color: #009fe3;">@(Model.AverageResolutionDays?.ToString("0.0") ?? "N/A")</div>
                            <div class="kpi-sub">Days to resolution</div>
                        </div>
                    </div>
                </div>

                <!-- Breakdown Analytics Row -->
                <div class="row g-4 mb-4">
                    <!-- Category Breakdown -->
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                            <h5 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-pie-chart me-2"></i> Breakdown by Category
                            </h5>
                            @if (!Model.CategoryBreakdown.Any())
                            {
                                <div class="text-muted small text-center py-4">No data available for the selected range.</div>
                            }
                            else
                            {
                                @foreach (var cat in Model.CategoryBreakdown)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small fw-semibold mb-1">
                                            <span>@cat.Name</span>
                                            <span class="text-muted">@cat.Count report(s) (@cat.Percentage%)</span>
                                        </div>
                                        <div class="marikina-progress">
                                            <div class="marikina-progress-bar-blue h-100" style="width: @cat.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Sitio / Purok Breakdown -->
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                            <h5 class="fw-bold brand-orange-text border-bottom pb-2 mb-3">
                                <i class="bi bi-geo-alt me-2"></i> Breakdown by Sitio / Purok
                            </h5>
                            @if (!Model.SitioBreakdown.Any())
                            {
                                <div class="text-muted small text-center py-4">No data available for the selected range.</div>
                            }
                            else
                            {
                                @foreach (var s in Model.SitioBreakdown)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small fw-semibold mb-1">
                                            <span>@s.Name</span>
                                            <span class="text-muted">@s.Count report(s) (@s.Percentage%)</span>
                                        </div>
                                        <div class="marikina-progress">
                                            <div class="marikina-progress-bar-orange h-100" style="width: @s.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Detailed Concerns Table -->
                <div class="marikina-table-card mb-4">
                    <div class="marikina-table-header">
                        <div>
                            <h6 class="marikina-table-title mb-0">
                                <i class="bi bi-table me-2"></i> Detailed Records (@Model.Concerns.Count items)
                            </h6>
                            <small class="text-muted">Audit-verified reports for the selected council reporting window</small>
                        </div>
                        <span class="badge bg-light text-secondary border px-3 py-1">Filtered Records</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table marikina-table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Reference No.</th>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Sitio / Purok</th>
                                    <th>Title &amp; Landmark</th>
                                    <th>Channel</th>
                                    <th>Status</th>
                                    <th>Assigned Staff</th>
                                    <th class="text-end pe-4">Resolved Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Concerns.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">No records match the selected date range and filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Concerns)
                                    {
                                        string statusBadge = item.Status switch
                                        {
                                            ConcernStatus.Submitted => "badge-marikina-new",
                                            ConcernStatus.UnderReview => "badge-marikina-review",
                                            ConcernStatus.Accepted => "badge-marikina-progress",
                                            ConcernStatus.Assigned => "badge-marikina-progress",
                                            ConcernStatus.InProgress => "badge-marikina-progress",
                                            ConcernStatus.Resolved => "badge-marikina-resolved",
                                            ConcernStatus.ForwardedToAgency => "badge-marikina-forwarded",
                                            ConcernStatus.NeedsMoreInfo => "badge-marikina-review",
                                            ConcernStatus.Rejected => "badge-marikina-rejected",
                                            _ => "badge-marikina-new"
                                        };

                                        <tr>
                                            <td class="fw-bold font-monospace brand-orange-text">@item.ReferenceNumber</td>
                                            <td class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@item.Category?.Name</span>
                                            </td>
                                            <td class="fw-semibold text-secondary">@item.Sitio?.Name</td>
                                            <td>
                                                <div class="fw-bold text-dark">@item.Title</div>
                                                <small class="text-muted">@item.LandmarkOrAddress</small>
                                            </td>
                                            <td><span class="badge-marikina-channel">@item.Channel</span></td>
                                            <td><span class="@statusBadge">@item.Status</span></td>
                                            <td class="small fw-semibold">@(item.AssignedToUser?.FullName ?? "—")</td>
                                            <td class="text-end pe-4 small text-muted">
                                                @(item.ResolvedAt.HasValue ? item.ResolvedAt.Value.ToLocalTime().ToString("yyyy-MM-dd") : "—")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Official Signature Block (Print-Only) -->
                <div class="print-only mt-5 pt-4">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-top border-dark mx-4 pt-2">
                                <strong class="d-block text-uppercase">Barangay Secretary</strong>
                                <small>Prepared by</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-top border-dark mx-4 pt-2">
                                <strong class="d-block text-uppercase">Punong Barangay</strong>
                                <small>Attested &amp; Approved by</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
