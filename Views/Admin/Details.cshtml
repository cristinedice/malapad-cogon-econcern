@model MalapadCogonEConcern.ViewModels.AdminConcernDetailViewModel
@using MalapadCogonEConcern.Models.Enums
@{
    var concern = Model.Concern;
    ViewData["Title"] = $"Manage Concern: {concern.ReferenceNumber}";

    string statusBadge = concern.Status switch
    {
        ConcernStatus.Submitted => "badge-marikina-new",
        ConcernStatus.UnderReview => "badge-marikina-review",
        ConcernStatus.Accepted => "badge-marikina-progress",
        ConcernStatus.Assigned => "badge-marikina-progress",
        ConcernStatus.InProgress => "badge-marikina-progress",
        ConcernStatus.Resolved => "badge-marikina-resolved",
        ConcernStatus.ForwardedToAgency => "badge-marikina-forwarded",
        ConcernStatus.NeedsMoreInfo => "badge-marikina-review",
        ConcernStatus.Rejected => "badge-marikina-rejected",
        _ => "badge-marikina-new"
    };

    var submissionPhoto = concern.Attachments.FirstOrDefault(a => a.AttachmentType == AttachmentType.SubmissionPhoto);
    var resolutionPhoto = concern.Attachments.FirstOrDefault(a => a.AttachmentType == AttachmentType.ResolutionProof);
}

<div class="marikina-page-wrapper position-relative">
    <!-- Signature Marikina Curved Blue Top Band -->
    <div class="marikina-top-blue-band no-print"></div>

    <div class="container-fluid px-lg-5 marikina-main-content">
        <div class="row g-4">
            <!-- LEFT: Floating Sidebar (Docked at Top-Left) -->
            <div class="col-lg-3 col-md-4 no-print">
                <partial name="_MarikinaSidebar" model='"AllConcerns"' />
            </div>

            <!-- RIGHT: Concern Details & Workflow Operations -->
            <div class="col-lg-9 col-md-8">
                <!-- Header in Blue Hero Section -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <a asp-action="Concerns" class="btn btn-sm btn-light brand-blue-text fw-bold px-2 py-1">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                            <span class="@statusBadge">@concern.Status</span>
                            <span class="badge-marikina-channel">@concern.Channel</span>
                        </div>
                        <h3 class="fw-bold text-white mb-0 text-uppercase" style="letter-spacing: 0.5px;">
                            <span class="brand-orange-text">@concern.ReferenceNumber</span> - @concern.Title
                        </h3>
                    </div>
                    <div class="mt-3 mt-md-0 no-print">
                        <button class="btn btn-light brand-blue-text btn-sm fw-bold shadow-sm px-3 py-2" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> Print Ticket
                        </button>
                    </div>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="row g-4">
                    <!-- Left Column: Details & Photos & History -->
                    <div class="col-lg-7">
                        <!-- Ticket Info Card -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                            <h5 class="fw-bold brand-blue-text border-bottom pb-3 mb-3">
                                <i class="bi bi-file-earmark-text me-2"></i> Concern Details
                            </h5>

                            <div class="row g-3 small mb-3">
                                <div class="col-sm-6">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Category</strong>
                                    <span class="badge bg-light text-dark border fs-6 mt-1">
                                        <i class="bi @concern.Category?.IconClass brand-blue-text me-1"></i> @concern.Category?.Name
                                    </span>
                                </div>
                                <div class="col-sm-6">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Sitio / Purok</strong>
                                    <span class="fs-6 fw-bold brand-blue-text mt-1 d-block">@concern.Sitio?.Name</span>
                                </div>
                                <div class="col-12">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Specific Location / Landmark</strong>
                                    <span class="text-dark fw-semibold"><i class="bi bi-geo-alt text-danger me-1"></i> @concern.LandmarkOrAddress</span>
                                </div>
                                <div class="col-12">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Full Description</strong>
                                    <div class="p-3 bg-light rounded-3 text-secondary mt-1" style="white-space: pre-wrap; font-size: 0.92rem;">@concern.Description</div>
                                </div>
                                <div class="col-sm-6">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Date Submitted</strong>
                                    <span class="text-dark">@concern.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy - hh:mm tt")</span>
                                </div>
                                <div class="col-sm-6">
                                    <strong class="text-muted d-block text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Currently Assigned To</strong>
                                    <span class="fw-bold text-dark">@(concern.AssignedToUser?.FullName ?? "Unassigned")</span>
                                </div>
                            </div>

                            @if (concern.Status == ConcernStatus.ForwardedToAgency)
                            {
                                <div class="alert alert-light border p-3 rounded-3 small">
                                    <strong class="brand-blue-text"><i class="bi bi-box-arrow-up-right me-1"></i> Forwarded to:</strong> @concern.ForwardedToAgency <br>
                                    <strong>Endorsement Ref:</strong> @(concern.ForwardedReferenceNo ?? "N/A") <br>
                                    <strong>Remarks:</strong> @concern.ForwardedRemarks
                                </div>
                            }
                        </div>

                        <!-- Complainant Identity Card (Confidential) -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h6 class="fw-bold brand-blue-text mb-0">
                                    <i class="bi bi-person-lock me-2 text-warning"></i> Complainant Information (Confidential)
                                </h6>
                                <span class="badge bg-warning bg-opacity-25 text-dark small">RA 10173 Protected</span>
                            </div>
                            <div class="row g-2 small">
                                <div class="col-sm-6">
                                    <strong class="text-muted text-uppercase" style="font-size: 0.72rem;">Name:</strong>
                                    <div class="fw-bold text-dark">@(string.IsNullOrEmpty(concern.ComplainantName) ? "Not Provided (Anonymous Online Report)" : concern.ComplainantName)</div>
                                </div>
                                <div class="col-sm-6">
                                    <strong class="text-muted text-uppercase" style="font-size: 0.72rem;">Contact / Phone:</strong>
                                    <div class="fw-bold text-dark">@(string.IsNullOrEmpty(concern.ComplainantContact) ? "None Provided" : concern.ComplainantContact)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Photos Card -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                            <h6 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-images me-2"></i> Evidence &amp; Resolution Photos
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-light text-center h-100">
                                        <small class="fw-bold text-muted d-block mb-2 text-uppercase" style="font-size: 0.72rem;">Original Submission Photo</small>
                                        @if (submissionPhoto != null)
                                        {
                                            var photoUrl = $"/uploads/concerns/{concern.CreatedAt.Year}/{concern.CreatedAt.Month:D2}/{submissionPhoto.StoredFileName}";
                                            <a href="@photoUrl" target="_blank">
                                                <img src="@photoUrl" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: cover;" alt="Submission photo" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="py-4 text-muted small"><i class="bi bi-image text-secondary fs-3 d-block mb-1"></i> No photo submitted</div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-light text-center h-100">
                                        <small class="fw-bold text-success d-block mb-2 text-uppercase" style="font-size: 0.72rem;">Proof of Resolution Photo</small>
                                        @if (resolutionPhoto != null)
                                        {
                                            var photoUrl = $"/uploads/resolutions/{resolutionPhoto.UploadedAt.Year}/{resolutionPhoto.UploadedAt.Month:D2}/{resolutionPhoto.StoredFileName}";
                                            <a href="@photoUrl" target="_blank">
                                                <img src="@photoUrl" class="img-fluid rounded border border-success shadow-sm" style="max-height: 200px; object-fit: cover;" alt="Resolution proof" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="py-4 text-muted small"><i class="bi bi-patch-question text-secondary fs-3 d-block mb-1"></i> No resolution photo uploaded yet</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Audit History -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <h6 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-clock-history me-2"></i> Status Transition &amp; Action History
                            </h6>
                            <div class="timeline">
                                @foreach (var h in concern.StatusHistories.OrderByDescending(h => h.ChangedAt))
                                {
                                    <div class="border-start border-3 border-primary ps-3 mb-3">
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span><strong>@h.ChangedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</strong></span>
                                            <span>By: @(h.ChangedByUser?.FullName ?? "System") (@(h.ChangedByUser?.Position ?? "LGU"))</span>
                                        </div>
                                        <div class="mt-1">
                                            <span class="badge bg-light text-dark border me-1">@h.PreviousStatus &rarr; @h.NewStatus</span>
                                            <span class="text-dark fw-bold">@h.PublicRemarks</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(h.InternalRemarks))
                                        {
                                            <div class="small text-muted fst-italic mt-1 bg-light p-2 rounded">
                                                <i class="bi bi-lock me-1"></i> <strong>Internal Staff Note:</strong> @h.InternalRemarks
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Operations / Workflow Controls -->
                    <div class="col-lg-5">
                        <!-- 1. Update Status Form -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                            <h5 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-arrow-repeat me-2 brand-orange-text"></i> Update Status &amp; Action
                            </h5>

                            <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ConcernId" value="@concern.Id" />

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Transition to New Status</label>
                                    <select name="NewStatus" class="form-select rounded-3" required>
                                        @foreach (ConcernStatus st in Enum.GetValues(typeof(ConcernStatus)))
                                        {
                                            <option value="@((int)st)" selected="@(st == concern.Status)">@st</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Public Remarks (Visible to Resident)</label>
                                    <textarea name="PublicRemarks" class="form-control rounded-3" rows="3" placeholder="Inform the resident of action taken..." required></textarea>
                                    <small class="text-muted">This update will appear on the resident's tracking page.</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Internal Remarks (Staff Only)</label>
                                    <textarea name="InternalRemarks" class="form-control rounded-3" rows="2" placeholder="Private notes for barangay personnel..."></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Upload Proof of Resolution Photo</label>
                                    <input type="file" name="ResolutionPhoto" class="form-control form-control-sm rounded-3" accept=".jpg,.jpeg,.png,.webp" />
                                    <small class="text-muted">Attach photo proof if marking as Resolved.</small>
                                </div>

                                <button type="submit" class="btn btn-marikina-orange w-100 fw-bold py-2 shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Apply Status Update
                                </button>
                            </form>
                        </div>

                        <!-- 2. Assign Personnel Card -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                            <h6 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-person-check me-2"></i> Assign Barangay Personnel
                            </h6>

                            <form asp-action="Assign" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="concernId" value="@concern.Id" />

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Select Authorized Staff Member</label>
                                    <select name="staffUserId" class="form-select form-select-sm rounded-3" required>
                                        <option value="">-- Choose Personnel --</option>
                                        @foreach (var staff in Model.AvailableStaff)
                                        {
                                            <option value="@staff.Id" selected="@(staff.Id == concern.AssignedToUserId)">
                                                @staff.FullName (@staff.Position)
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Assignment Instructions</label>
                                    <input type="text" name="assignNotes" class="form-control form-control-sm rounded-3" placeholder="e.g. Conduct ocular inspection this afternoon" />
                                </div>

                                <button type="submit" class="btn btn-marikina-blue w-100 fw-bold py-2 btn-sm">
                                    <i class="bi bi-person-plus me-1"></i> Save Assignment
                                </button>
                            </form>
                        </div>

                        <!-- 3. Forward to Municipal Agency -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <h6 class="fw-bold brand-blue-text border-bottom pb-2 mb-3">
                                <i class="bi bi-box-arrow-up-right me-2 text-secondary"></i> Forward to Municipal Agency
                            </h6>
                            <p class="small text-muted mb-3">
                                Use when the concern exceeds barangay jurisdiction (e.g. municipal road, major floodway, electrical power lines).
                            </p>

                            <form asp-action="Forward" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ConcernId" value="@concern.Id" />

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Agency Name</label>
                                    <input type="text" name="AgencyName" list="agencies" class="form-control form-control-sm rounded-3" placeholder="e.g. Sigma Municipal Engineering Office" required />
                                    <datalist id="agencies">
                                        <option value="Sigma Municipal Engineering Office" />
                                        <option value="Sigma MENRO (Environment & Natural Resources)" />
                                        <option value="CAPELCO (Capiz Electric Cooperative)" />
                                        <option value="Capiz Provincial Engineering Office" />
                                        <option value="DPWH Capiz 1st District" />
                                    </datalist>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Endorsement Reference No. (Optional)</label>
                                    <input type="text" name="EndorsementRefNo" class="form-control form-control-sm rounded-3" placeholder="e.g. LGU-SIGMA-TRANS-2026-04" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size: 0.72rem;">Endorsement Reason &amp; Remarks</label>
                                    <textarea name="EndorsementNotes" class="form-control form-control-sm rounded-3" rows="2" placeholder="Details of referral to the agency..." required></textarea>
                                </div>

                                <button type="submit" class="btn btn-outline-secondary w-100 fw-bold py-2 btn-sm rounded-3">
                                    <i class="bi bi-send me-1"></i> Forward to Agency
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
