@model MalapadCogonEConcern.ViewModels.AdminDashboardViewModel
@using MalapadCogonEConcern.Models.Enums
@{
    ViewData["Title"] = "Barangay Operations Dashboard";
}

<div class="marikina-page-wrapper position-relative">
    <!-- Signature Marikina Curved Blue Top Band -->
    <div class="marikina-top-blue-band"></div>

    <div class="container-fluid px-lg-5 marikina-main-content">
        <div class="row g-4">
            <!-- LEFT: Floating Sidebar (Docked at Top-Left, Level with User Header) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_MarikinaSidebar" model='"AdminDashboard"' />
            </div>

            <!-- RIGHT: Barangay Operations Center & Analytics -->
            <div class="col-lg-9 col-md-8">
                <!-- User / Portal Header in Blue Hero Section -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white brand-blue-text fw-bold text-uppercase px-2 py-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                <i class="bi bi-shield-check me-1"></i> Official Portal
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-0 text-uppercase" style="letter-spacing: 0.5px;">
                            Barangay Operations Dashboard
                        </h3>
                        <small class="text-white-50 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">
                            Malapad Cogon e-Concern Management &amp; Tracking Center
                        </small>
                    </div>
                    <div class="d-flex gap-2 mt-3 mt-md-0">
                        <a asp-action="CreateAssisted" class="btn btn-marikina-orange fw-bold btn-sm shadow-sm px-3 py-2">
                            <i class="bi bi-person-plus-fill me-1"></i> Walk-In Intake
                        </a>
                        <a asp-action="Concerns" class="btn btn-light brand-blue-text fw-bold btn-sm shadow-sm px-3 py-2">
                            <i class="bi bi-card-checklist me-1"></i> View All Concerns
                        </a>
                        <button class="btn btn-outline-light btn-sm px-2 py-2" onclick="location.reload();" title="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- KPI Metric Cards (6 Marikina Styled Cards) -->
                <div class="row g-3 mb-4">
                    <!-- Total Reports -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" class="marikina-kpi-card" style="border-top: 4px solid #0b5791;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">Total Reports</div>
                                    <div class="kpi-num brand-blue-text">@Model.TotalConcerns</div>
                                    <div class="kpi-sub">All-time received</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #e0f2fe; color: #0b5791;">
                                    <i class="bi bi-folder2-open"></i>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Under Review -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" asp-route-status="@((int)ConcernStatus.UnderReview)" class="marikina-kpi-card" style="border-top: 4px solid #009fe3;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">Under Review</div>
                                    <div class="kpi-num" style="color: #009fe3;">@Model.UnderReviewConcerns</div>
                                    <div class="kpi-sub">Awaiting triage</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #e0f7ff; color: #009fe3;">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- In Progress -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" asp-route-status="@((int)ConcernStatus.InProgress)" class="marikina-kpi-card" style="border-top: 4px solid #eb5722;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">In Progress</div>
                                    <div class="kpi-num brand-orange-text">@Model.InProgressConcerns</div>
                                    <div class="kpi-sub">Field action ongoing</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #ffedd5; color: #eb5722;">
                                    <i class="bi bi-tools"></i>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Forwarded -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" asp-route-status="@((int)ConcernStatus.ForwardedToAgency)" class="marikina-kpi-card" style="border-top: 4px solid #7c3aed;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">Forwarded</div>
                                    <div class="kpi-num" style="color: #7c3aed;">@Model.ForwardedConcerns</div>
                                    <div class="kpi-sub">Sigma LGU / Agency</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #f3e8ff; color: #7c3aed;">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Resolved -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" asp-route-status="@((int)ConcernStatus.Resolved)" class="marikina-kpi-card" style="border-top: 4px solid #059669;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">Resolved</div>
                                    <div class="kpi-num" style="color: #059669;">@Model.ResolvedConcerns</div>
                                    <div class="kpi-sub">Completed cases</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #d1fae5; color: #059669;">
                                    <i class="bi bi-check2-circle"></i>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Overdue -->
                    <div class="col-sm-6 col-xl-4 col-xxl-2">
                        <a asp-action="Concerns" class="marikina-kpi-card" style="border-top: 4px solid #dc2626;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="kpi-label">Overdue (>7d)</div>
                                    <div class="kpi-num" style="color: #dc2626;">@Model.LongPendingConcerns</div>
                                    <div class="kpi-sub">Priority attention</div>
                                </div>
                                <div class="kpi-icon-pill" style="background-color: #fee2e2; color: #dc2626;">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Recent Submissions Table (Marikina Styled Table Card) -->
                <div class="marikina-table-card mb-4">
                    <div class="marikina-table-header">
                        <div>
                            <h5 class="marikina-table-title mb-0">
                                <i class="bi bi-clock-history brand-blue-text me-2"></i> Recent Community Submissions
                            </h5>
                            <small class="text-muted">Live reports from online portal and walk-in barangay intake desk</small>
                        </div>
                        <a asp-action="Concerns" class="btn btn-sm btn-marikina-blue px-3 py-1">
                            View All <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table marikina-table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Reference No.</th>
                                    <th>Category</th>
                                    <th>Sitio / Purok</th>
                                    <th>Title &amp; Landmark</th>
                                    <th>Channel</th>
                                    <th>Status</th>
                                    <th>Date Submitted</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentConcerns.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                            <div class="fw-bold">No community concerns recorded yet.</div>
                                            <small>New submissions will appear here automatically.</small>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.RecentConcerns)
                                    {
                                        string statusBadge = item.Status switch
                                        {
                                            ConcernStatus.Submitted => "badge-marikina-new",
                                            ConcernStatus.UnderReview => "badge-marikina-review",
                                            ConcernStatus.Accepted => "badge-marikina-progress",
                                            ConcernStatus.Assigned => "badge-marikina-progress",
                                            ConcernStatus.InProgress => "badge-marikina-progress",
                                            ConcernStatus.Resolved => "badge-marikina-resolved",
                                            ConcernStatus.ForwardedToAgency => "badge-marikina-forwarded",
                                            ConcernStatus.NeedsMoreInfo => "badge-marikina-review",
                                            ConcernStatus.Rejected => "badge-marikina-rejected",
                                            _ => "badge-marikina-new"
                                        };

                                        <tr>
                                            <td class="fw-bold font-monospace brand-orange-text">
                                                @item.ReferenceNumber
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    <i class="bi @item.Category?.IconClass brand-blue-text me-1"></i> @item.Category?.Name
                                                </span>
                                            </td>
                                            <td class="fw-semibold text-secondary">@item.Sitio?.Name</td>
                                            <td>
                                                <div class="fw-bold text-dark">@item.Title</div>
                                                <small class="text-muted"><i class="bi bi-geo-alt text-danger"></i> @item.LandmarkOrAddress</small>
                                            </td>
                                            <td>
                                                <span class="badge-marikina-channel">@item.Channel</span>
                                            </td>
                                            <td>
                                                <span class="@statusBadge">@item.Status</span>
                                            </td>
                                            <td class="small text-muted">
                                                @item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                                    <i class="bi bi-gear me-1"></i> Manage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
