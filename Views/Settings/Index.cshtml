@model MalapadCogonEConcern.ViewModels.SettingsDashboardViewModel
@{
    ViewData["Title"] = "Barangay System Administration & Settings";
}

<div class="container-fluid py-4 px-lg-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-sliders text-success me-2"></i> System Administration &amp; Configuration
            </h3>
            <p class="text-muted small mb-0">Manage community categories, sitios/puroks, staff accounts, and view security audit logs</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border" id="settingsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold small" id="categories-tab" data-bs-toggle="pill" data-bs-target="#categories-pane" type="button" role="tab">
                <i class="bi bi-tags me-1"></i> Categories (@Model.Categories.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold small" id="sitios-tab" data-bs-toggle="pill" data-bs-target="#sitios-pane" type="button" role="tab">
                <i class="bi bi-geo-alt me-1"></i> Sitios / Puroks (@Model.Sitios.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold small" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                <i class="bi bi-people me-1"></i> Staff Accounts (@Model.StaffUsers.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold small" id="audit-tab" data-bs-toggle="pill" data-bs-target="#audit-pane" type="button" role="tab">
                <i class="bi bi-shield-check me-1"></i> Security Audit Trail
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="settingsTabContent">
        <!-- 1. CATEGORIES PANE -->
        <div class="tab-pane fade show active" id="categories-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">Concern Categories</h5>
                    <button class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalAddCategory">
                        <i class="bi bi-plus-circle me-1"></i> Add Category
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4">Icon</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Display Order</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="bg-success text-white p-2 rounded text-center" style="width: 36px; height: 36px;">
                                            <i class="bi @cat.IconClass"></i>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-dark">@cat.Name</td>
                                    <td class="text-muted small">@cat.Description</td>
                                    <td>@cat.DisplayOrder</td>
                                    <td>
                                        <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary")">
                                            @(cat.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="ToggleCategory" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(cat.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. SITIOS / PUROKS PANE -->
        <div class="tab-pane fade" id="sitios-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">Sitios &amp; Puroks in Barangay Malapad Cogon</h5>
                    <button class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalAddSitio">
                        <i class="bi bi-plus-circle me-1"></i> Add Sitio / Purok
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Description / Area</th>
                                <th>Display Order</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Sitios)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@s.Name</td>
                                    <td class="text-muted small">@s.Description</td>
                                    <td>@s.DisplayOrder</td>
                                    <td>
                                        <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                            @(s.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="ToggleSitio" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(s.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. STAFF ACCOUNTS PANE -->
        <div class="tab-pane fade" id="users-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">Authorized Barangay Personnel Accounts</h5>
                    <button class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalAddStaff">
                        <i class="bi bi-person-plus me-1"></i> Create Staff Account
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4">Full Name</th>
                                <th>Email / Login</th>
                                <th>Position</th>
                                <th>Role</th>
                                <th>Assigned Reports</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.StaffUsers)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@u.FullName</td>
                                    <td><code>@u.Email</code></td>
                                    <td><span class="badge bg-light text-dark border">@u.Position</span></td>
                                    <td>
                                        <span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-primary")">@u.Role</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@u.AssignedCount</span>
                                    </td>
                                    <td>
                                        <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                            @(u.IsActive ? "Active" : "Deactivated")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-warning" 
                                                onclick="openResetPasswordModal('@u.Id', '@u.FullName')">
                                            <i class="bi bi-key"></i> Reset
                                        </button>
                                        <form asp-action="ToggleStaffStatus" method="post" class="d-inline ms-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(u.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. SECURITY AUDIT TRAIL PANE -->
        <div class="tab-pane fade" id="audit-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">System Security &amp; Activity Audit Log</h5>
                    <span class="badge bg-light text-muted border">Latest 50 Operations</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 font-size-sm">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-4">Timestamp</th>
                                <th>Action</th>
                                <th>Actor</th>
                                <th>Target Entity</th>
                                <th>Details</th>
                                <th class="text-end pe-4">IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentAuditLogs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No audit events recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.RecentAuditLogs)
                                {
                                    <tr>
                                        <td class="ps-4 small text-muted">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                        <td class="small fw-semibold">@(log.User?.FullName ?? "System")</td>
                                        <td><code>@log.EntityName (@log.EntityId)</code></td>
                                        <td class="small text-secondary">@log.Details</td>
                                        <td class="text-end pe-4 small text-muted font-monospace">@log.IpAddress</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ADD CATEGORY -->
<div class="modal fade" id="modalAddCategory" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Concern Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Category Name</label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g. Street Lighting" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Brief explanation of issues covered..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold">Bootstrap Icon Class</label>
                            <input type="text" name="IconClass" class="form-control" value="bi-tag" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Display Order</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="10" />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked id="catActive" />
                        <label class="form-check-label small" for="catActive">Category is Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD SITIO -->
<div class="modal fade" id="modalAddSitio" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Sitio / Purok</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveSitio" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Sitio / Purok Name</label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g. Purok 7 or Sitio Kawayan" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description / Boundary</label>
                        <input type="text" name="Description" class="form-control" placeholder="e.g. Near boundary with Barangay..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="10" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked id="sitioActive" />
                        <label class="form-check-label small" for="sitioActive">Sitio is Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold">Save Sitio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD STAFF -->
<div class="modal fade" id="modalAddStaff" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create Authorized Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Full Name</label>
                        <input type="text" name="FullName" class="form-control" required placeholder="e.g. Kagawad Juan Dela Cruz" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Barangay Position</label>
                        <input type="text" name="Position" class="form-control" required placeholder="e.g. Barangay Kagawad / Tanod Executive Officer" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Official Email / Login</label>
                        <input type="email" name="Email" class="form-control" required placeholder="staff.juandelacruz@malapadcogon.gov.ph" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">System Role</label>
                        <select name="Role" class="form-select">
                            <option value="Staff" selected>Barangay Staff (View assigned, update status)</option>
                            <option value="Admin">Barangay Administrator (Full system &amp; user control)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Password</label>
                            <input type="password" name="Password" class="form-control" required minlength="6" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required minlength="6" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: RESET PASSWORD -->
<div class="modal fade" id="modalResetPassword" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetStaffPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-body">
                    <p class="small text-muted mb-2">Reset password for: <strong id="resetUserName" class="text-dark"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">New Password</label>
                        <input type="password" name="newPassword" class="form-control" minlength="6" required placeholder="Minimum 6 characters" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm fw-bold">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPasswordModal(userId, fullName) {
            document.getElementById('resetUserId').value = userId;
            document.getElementById('resetUserName').innerText = fullName;
            const modal = new bootstrap.Modal(document.getElementById('modalResetPassword'));
            modal.show();
        }
    </script>
}
