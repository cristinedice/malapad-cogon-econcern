@model MalapadCogonEConcern.ViewModels.SettingsDashboardViewModel
@{
    ViewData["Title"] = "Barangay System Administration & Settings";
}

<div class="marikina-page-wrapper position-relative">
    <!-- Signature Marikina Curved Blue Top Band -->
    <div class="marikina-top-blue-band"></div>

    <div class="container-fluid px-lg-5 marikina-main-content">
        <div class="row g-4">
            <!-- LEFT: Floating Sidebar (Docked at Top-Left) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_MarikinaSidebar" model='"Settings"' />
            </div>

            <!-- RIGHT: System Settings & Configuration -->
            <div class="col-lg-9 col-md-8">
                <!-- Header in Blue Hero Section -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white brand-blue-text fw-bold text-uppercase px-2 py-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                <i class="bi bi-sliders me-1"></i> System Setup
                            </span>
                        </div>
                        <h3 class="fw-bold text-white mb-0 text-uppercase" style="letter-spacing: 0.5px;">
                            System Administration &amp; Configuration
                        </h3>
                        <small class="text-white-50 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">
                            Manage community categories, sitios/puroks, staff accounts, and view security audit logs
                        </small>
                    </div>
                    <div class="d-flex gap-2 mt-3 mt-md-0">
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-light brand-blue-text fw-bold btn-sm shadow-sm px-3 py-2">
                            <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
                        </a>
                    </div>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show small rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Navigation Tabs (Marikina Custom Nav-Pills) -->
                <ul class="nav marikina-nav-pills mb-4" id="settingsTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="categories-tab" data-bs-toggle="pill" data-bs-target="#categories-pane" type="button" role="tab">
                            <i class="bi bi-tags me-1"></i> Categories (@Model.Categories.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="sitios-tab" data-bs-toggle="pill" data-bs-target="#sitios-pane" type="button" role="tab">
                            <i class="bi bi-geo-alt me-1"></i> Sitios / Puroks (@Model.Sitios.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                            <i class="bi bi-people me-1"></i> Staff Accounts (@Model.StaffUsers.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="audit-tab" data-bs-toggle="pill" data-bs-target="#audit-pane" type="button" role="tab">
                            <i class="bi bi-shield-check me-1"></i> Security Audit Trail
                        </button>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content" id="settingsTabContent">
                    <!-- 1. CATEGORIES PANE -->
                    <div class="tab-pane fade show active" id="categories-pane" role="tabpanel">
                        <div class="marikina-table-card mb-4">
                            <div class="marikina-table-header">
                                <div>
                                    <h5 class="marikina-table-title mb-0">Concern Categories</h5>
                                    <small class="text-muted">Classifications available to residents when filing reports</small>
                                </div>
                                <button class="btn btn-sm btn-marikina-orange fw-bold px-3" data-bs-toggle="modal" data-bs-target="#modalAddCategory">
                                    <i class="bi bi-plus-circle me-1"></i> Add Category
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table marikina-table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Icon</th>
                                            <th>Category Name</th>
                                            <th>Description</th>
                                            <th>Display Order</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center justify-content-center" 
                                                         style="background-color: #e0f2fe; color: #0b5791; width: 40px; height: 40px; border-radius: 10px; font-size: 1.15rem;">
                                                        <i class="bi @cat.IconClass"></i>
                                                    </div>
                                                </td>
                                                <td class="fw-bold brand-blue-text">@cat.Name</td>
                                                <td class="text-muted small">@cat.Description</td>
                                                <td class="fw-semibold text-secondary">@cat.DisplayOrder</td>
                                                <td>
                                                    <span class="@(cat.IsActive ? "badge-marikina-resolved" : "badge-marikina-channel")">
                                                        @(cat.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <form asp-action="ToggleCategory" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@cat.Id" />
                                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(cat.IsActive ? "btn-outline-danger" : "btn-outline-primary")">
                                                            @(cat.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 2. SITIOS / PUROKS PANE -->
                    <div class="tab-pane fade" id="sitios-pane" role="tabpanel">
                        <div class="marikina-table-card mb-4">
                            <div class="marikina-table-header">
                                <div>
                                    <h5 class="marikina-table-title mb-0">Sitios &amp; Puroks in Barangay Malapad Cogon</h5>
                                    <small class="text-muted">Geographical sectors for community issue assignment and analytics</small>
                                </div>
                                <button class="btn btn-sm btn-marikina-orange fw-bold px-3" data-bs-toggle="modal" data-bs-target="#modalAddSitio">
                                    <i class="bi bi-plus-circle me-1"></i> Add Sitio / Purok
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table marikina-table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Description / Area</th>
                                            <th>Display Order</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in Model.Sitios)
                                        {
                                            <tr>
                                                <td class="fw-bold brand-blue-text">@s.Name</td>
                                                <td class="text-muted small">@s.Description</td>
                                                <td class="fw-semibold text-secondary">@s.DisplayOrder</td>
                                                <td>
                                                    <span class="@(s.IsActive ? "badge-marikina-resolved" : "badge-marikina-channel")">
                                                        @(s.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <form asp-action="ToggleSitio" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(s.IsActive ? "btn-outline-danger" : "btn-outline-primary")">
                                                            @(s.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 3. STAFF ACCOUNTS PANE -->
                    <div class="tab-pane fade" id="users-pane" role="tabpanel">
                        <div class="marikina-table-card mb-4">
                            <div class="marikina-table-header">
                                <div>
                                    <h5 class="marikina-table-title mb-0">Authorized Barangay Personnel Accounts</h5>
                                    <small class="text-muted">Staff and administrators empowered to triage and resolve community reports</small>
                                </div>
                                <button class="btn btn-sm btn-marikina-orange fw-bold px-3" data-bs-toggle="modal" data-bs-target="#modalAddStaff">
                                    <i class="bi bi-person-plus me-1"></i> Create Staff Account
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table marikina-table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Full Name</th>
                                            <th>Email / Login</th>
                                            <th>Position</th>
                                            <th>Role</th>
                                            <th>Assigned Reports</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in Model.StaffUsers)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@u.FullName</td>
                                                <td><span class="badge bg-light text-dark border font-monospace">@u.Email</span></td>
                                                <td><span class="badge bg-light text-secondary border">@u.Position</span></td>
                                                <td>
                                                    <span class="badge @(u.Role == "Admin" ? "bg-danger" : "btn-marikina-blue") px-2 py-1">@u.Role</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-secondary border">@u.AssignedCount active</span>
                                                </td>
                                                <td>
                                                    <span class="@(u.IsActive ? "badge-marikina-resolved" : "badge-marikina-rejected")">
                                                        @(u.IsActive ? "Active" : "Deactivated")
                                                    </span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-sm btn-outline-warning rounded-pill px-3" 
                                                            onclick="openResetPasswordModal('@u.Id', '@u.FullName')">
                                                        <i class="bi bi-key"></i> Reset
                                                    </button>
                                                    <form asp-action="ToggleStaffStatus" method="post" class="d-inline ms-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@u.Id" />
                                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(u.IsActive ? "btn-outline-danger" : "btn-outline-primary")">
                                                            @(u.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 4. SECURITY AUDIT TRAIL PANE -->
                    <div class="tab-pane fade" id="audit-pane" role="tabpanel">
                        <div class="marikina-table-card mb-4">
                            <div class="marikina-table-header">
                                <div>
                                    <h5 class="marikina-table-title mb-0">System Security &amp; Activity Audit Log</h5>
                                    <small class="text-muted">Immutable log of operations for Republic Act 10173 and DILG accountability</small>
                                </div>
                                <span class="badge bg-light text-muted border px-3 py-1">Latest 50 Operations</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table marikina-table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Action</th>
                                            <th>Actor</th>
                                            <th>Target Entity</th>
                                            <th>Details</th>
                                            <th class="text-end pe-4">IP Address</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!Model.RecentAuditLogs.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">No audit events recorded yet.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var log in Model.RecentAuditLogs)
                                            {
                                                <tr>
                                                    <td class="small text-muted font-monospace">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                    <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                                    <td class="small fw-bold brand-blue-text">@(log.User?.FullName ?? "System")</td>
                                                    <td><code class="text-secondary">@log.EntityName (@log.EntityId)</code></td>
                                                    <td class="small text-secondary">@log.Details</td>
                                                    <td class="text-end pe-4 small text-muted font-monospace">@log.IpAddress</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ADD CATEGORY -->
<div class="modal fade" id="modalAddCategory" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold brand-blue-text">Add Concern Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Category Name</label>
                        <input type="text" name="Name" class="form-control rounded-3" required placeholder="e.g. Street Lighting" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Description</label>
                        <textarea name="Description" class="form-control rounded-3" rows="2" placeholder="Brief explanation of issues covered..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-muted">Bootstrap Icon Class</label>
                            <input type="text" name="IconClass" class="form-control rounded-3" value="bi-tag" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-muted">Display Order</label>
                            <input type="number" name="DisplayOrder" class="form-control rounded-3" value="10" />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked id="catActive" />
                        <label class="form-check-label small" for="catActive">Category is Active</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-marikina-orange btn-sm fw-bold px-3">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD SITIO -->
<div class="modal fade" id="modalAddSitio" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold brand-blue-text">Add Sitio / Purok</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveSitio" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Sitio / Purok Name</label>
                        <input type="text" name="Name" class="form-control rounded-3" required placeholder="e.g. Purok 7 or Sitio Kawayan" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Description / Boundary</label>
                        <input type="text" name="Description" class="form-control rounded-3" placeholder="e.g. Near boundary with Barangay..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control rounded-3" value="10" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked id="sitioActive" />
                        <label class="form-check-label small" for="sitioActive">Sitio is Active</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-marikina-orange btn-sm fw-bold px-3">Save Sitio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ADD STAFF -->
<div class="modal fade" id="modalAddStaff" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold brand-blue-text">Create Authorized Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Full Name</label>
                        <input type="text" name="FullName" class="form-control rounded-3" required placeholder="e.g. Kagawad Juan Dela Cruz" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Barangay Position</label>
                        <input type="text" name="Position" class="form-control rounded-3" required placeholder="e.g. Barangay Kagawad / Tanod Executive Officer" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Official Email / Login</label>
                        <input type="email" name="Email" class="form-control rounded-3" required placeholder="staff.juandelacruz@malapadcogon.gov.ph" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">System Role</label>
                        <select name="Role" class="form-select rounded-3">
                            <option value="Staff" selected>Barangay Staff (View assigned, update status)</option>
                            <option value="Admin">Barangay Administrator (Full system &amp; user control)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Password</label>
                            <input type="password" name="Password" class="form-control rounded-3" required minlength="6" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control rounded-3" required minlength="6" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-marikina-orange btn-sm fw-bold px-3">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: RESET PASSWORD -->
<div class="modal fade" id="modalResetPassword" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold brand-blue-text">Reset Staff Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetStaffPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-body">
                    <p class="small text-muted mb-2">Reset password for: <strong id="resetUserName" class="text-dark"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">New Password</label>
                        <input type="password" name="newPassword" class="form-control rounded-3" minlength="6" required placeholder="Minimum 6 characters" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-marikina-orange btn-sm fw-bold px-3">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPasswordModal(userId, fullName) {
            document.getElementById('resetUserId').value = userId;
            document.getElementById('resetUserName').innerText = fullName;
            const modal = new bootstrap.Modal(document.getElementById('modalResetPassword'));
            modal.show();
        }
    </script>
}
