@model MalapadCogonEConcern.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login - Malapad Cogon e-Concern";
    Layout = null; // Clean full-bleed page matching Image 2
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Cristine Dice" />
    <title>Login - Barangay Malapad Cogon e-Concern</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/marikina-style.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>
    <div class="container pt-3 pt-md-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 text-center">
                <!-- Seal -->
                <div class="mb-2">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/malapad-cogon-seal.svg" alt="Barangay Malapad Cogon Seal" style="width: 90px; height: 90px;" />
                    </a>
                </div>

                <!-- Brand Title -->
                <h2 class="brand-title mb-3">
                    <span class="brand-blue-text d-block" style="font-size: 1.9rem; font-weight: 800; letter-spacing: -0.5px;">MALAPAD COGON</span>
                    <span class="brand-orange-text d-block" style="font-size: 1.8rem; font-weight: 700; margin-top: -6px;">e-Concern</span>
                </h2>

                <!-- Heading & Sign Up Prompt (Matching Image 2) -->
                <h4 class="fw-bold brand-blue-text mb-1" style="letter-spacing: 0.5px;">LOGIN HERE</h4>
                <p class="text-muted small mb-4">
                    Don't have an account? 
                    <a asp-action="Register" class="brand-blue-text fw-bold text-decoration-none">Sign Up Now</a>
                </p>

                <!-- Login Form with Underline Inputs -->
                <form asp-action="Login" method="post" class="text-start mx-auto" style="max-width: 420px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- Email Field -->
                    <div class="marikina-input-group">
                        <label asp-for="Email">Email</label>
                        <i class="bi bi-person-fill marikina-input-icon"></i>
                        <input asp-for="Email" class="marikina-input-field" placeholder="example@email.com" required autofocus />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="marikina-input-group">
                        <label asp-for="Password">Password</label>
                        <i class="bi bi-lock-fill marikina-input-icon"></i>
                        <input asp-for="Password" type="password" id="passwordInput" class="marikina-input-field" placeholder="Password" required />
                        <i class="bi bi-eye marikina-input-eye" id="togglePasswordBtn"></i>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Sign In Button -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-marikina-blue py-3 fs-6 shadow-sm">
                            Sign In
                        </button>
                    </div>

                    <!-- Forgot Password Link (Matching Image 2) -->
                    <div class="text-center mb-3">
                        <a href="#" class="brand-orange-text fw-bold text-decoration-none small" onclick="alert('Palihog mag-coordinate sa Barangay Secretary / Desk Officer para sa password reset.')">
                            Forgot Password
                        </a>
                    </div>
                </form>

                <!-- Default Accounts Helper Badge -->
                <div class="mt-2 text-center">
                    <button class="btn btn-sm btn-link text-muted small text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#devAccounts">
                        <i class="bi bi-info-circle me-1"></i> Demo Accounts (Click to view)
                    </button>
                    <div class="collapse mt-2" id="devAccounts">
                        <div class="card card-body bg-light border-0 py-2 small text-muted mx-auto" style="max-width: 400px; font-size: 0.82rem;">
                            <div><strong>Admin:</strong> <code>admin@malapadcogon.gov.ph</code> &bull; <code>Admin@Malapad2026!</code></div>
                            <div><strong>Staff:</strong> <code>staff@malapadcogon.gov.ph</code> &bull; <code>Staff@Malapad2026!</code></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Wave Illustration (Matching Image 2) -->
    <div class="bottom-wave-wrapper mt-3">
        <img src="~/images/community-wave-footer.svg" class="bottom-wave-img" alt="Community Wave Footer" />
        <div class="bottom-overlay-badge">
            <span class="text-alagang">Alagang</span>
            <span class="text-place">Malapad Cogon</span>
            <span class="text-unit">Barangay</span>
        </div>
    </div>

    <!-- Official Developer Ownership Sub-Footer -->
    <div class="py-2 text-center text-muted small bg-white border-top position-relative z-3" style="font-size: 0.8rem;">
        Barangay Malapad Cogon e-Concern &bull; System Designed &amp; Developed by <strong class="brand-blue-text">Cristine Dice</strong>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('passwordInput');
        toggleBtn.addEventListener('click', function() {
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });
    </script>
</body>
</html>
