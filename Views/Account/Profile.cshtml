@model MalapadCogonEConcern.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile - Account Settings";
}

<div class="marikina-page-wrapper">
    <!-- Top Blue Background Band (Matching Image 3) -->
    <div class="marikina-top-blue-band"></div>

    <div class="container-fluid px-lg-5 marikina-main-content">
        <div class="row g-4">
            <!-- LEFT: Floating Sidebar (Positioned at Top-Left, Level with Profile Heading!) -->
            <div class="col-lg-3 col-md-4">
                <div class="marikina-sidebar">
                    <a asp-controller="Home" asp-action="Dashboard" class="sidebar-nav-item">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Home</span>
                    </a>
                    <a asp-controller="Concern" asp-action="SelectCategory" class="sidebar-nav-item">
                        <i class="bi bi-send-fill"></i>
                        <span>Submit Concern</span>
                    </a>
                    <a asp-controller="Concern" asp-action="MyConcerns" class="sidebar-nav-item">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>My Concern</span>
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="sidebar-nav-item active">
                        <i class="bi bi-person-fill"></i>
                        <span>Profile</span>
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <hr class="border-light opacity-25 my-3">
                        <small class="text-white-50 text-uppercase fw-bold px-3 d-block mb-2" style="font-size: 0.72rem;">Official Portal</small>
                        <a asp-controller="Admin" asp-action="Index" class="sidebar-nav-item">
                            <i class="bi bi-speedometer2"></i>
                            <span>Admin Dashboard</span>
                        </a>
                        <a asp-controller="Reports" asp-action="Index" class="sidebar-nav-item">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            <span>Council Reports</span>
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Settings" asp-action="Index" class="sidebar-nav-item">
                                <i class="bi bi-sliders"></i>
                                <span>Settings</span>
                            </a>
                        }
                    }
                </div>
            </div>

            <!-- RIGHT: Profile View (Matching Image 3) -->
            <div class="col-lg-9 col-md-8">
                <!-- Back Arrow & Title (Matching Image 3: "← Profile") -->
                <div class="mb-3">
                    <a asp-controller="Home" asp-action="Dashboard" class="text-white text-decoration-none fw-bold fs-3 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i> Profile
                    </a>
                </div>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show small" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @Model.StatusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Plum/Maroon User Info Card (Matching Image 3) -->
                <div class="profile-maroon-card">
                    <div class="profile-name">@Model.User.FullName</div>
                    <div class="profile-email">@(Model.User.Email ?? "")</div>
                </div>

                <!-- White Change Password Card (Matching Image 3) -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white">
                    <h4 class="fw-bold brand-blue-text mb-4">Change Password</h4>

                    <form asp-action="ChangePassword" method="post" id="profilePasswordForm">
                        @Html.AntiForgeryToken()

                        <!-- Current Password (Matching Image 3) -->
                        <div class="marikina-input-group mb-4">
                            <label asp-for="ChangePassword.CurrentPassword">Current Password</label>
                            <i class="bi bi-lock-fill marikina-input-icon"></i>
                            <input asp-for="ChangePassword.CurrentPassword" type="password" id="curPass" class="marikina-input-field" placeholder="Current Password" required />
                            <i class="bi bi-eye marikina-input-eye" onclick="togglePass('curPass', this)"></i>
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- New Password (Matching Image 3) -->
                        <div class="marikina-input-group mb-2">
                            <label asp-for="ChangePassword.NewPassword">New Password</label>
                            <i class="bi bi-lock-fill marikina-input-icon"></i>
                            <input asp-for="ChangePassword.NewPassword" type="password" id="newPass" class="marikina-input-field" placeholder="Password" required />
                            <i class="bi bi-eye marikina-input-eye" onclick="togglePass('newPass', this)"></i>
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Password Strength Segments (Matching Image 3) -->
                        <div class="password-meter-bar mb-3">
                            <div class="password-meter-segment" id="seg1"></div>
                            <div class="password-meter-segment" id="seg2"></div>
                            <div class="password-meter-segment" id="seg3"></div>
                            <div class="password-meter-segment" id="seg4"></div>
                        </div>

                        <!-- Password Requirements Text (Matching Image 3) -->
                        <div class="small mb-4">
                            <div class="text-muted mb-1 fw-semibold">Password must contain the following:</div>
                            <div class="text-danger" id="reqUpper">
                                <i class="bi bi-x-circle me-1"></i> At least one Upper case character
                            </div>
                            <div class="text-danger" id="reqLength">
                                <i class="bi bi-x-circle me-1"></i> Minimum 6 characters
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="marikina-input-group mb-4">
                            <label asp-for="ChangePassword.ConfirmNewPassword">Confirm New Password</label>
                            <i class="bi bi-lock-fill marikina-input-icon"></i>
                            <input asp-for="ChangePassword.ConfirmNewPassword" type="password" id="confirmPass" class="marikina-input-field" placeholder="Re-enter New Password" required />
                            <i class="bi bi-eye marikina-input-eye" onclick="togglePass('confirmPass', this)"></i>
                            <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Submit Button -->
                        <div>
                            <button type="submit" class="btn btn-marikina-blue px-4 py-2 fw-bold">
                                Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(inputId, icon) {
            const el = document.getElementById(inputId);
            const isPassword = el.getAttribute('type') === 'password';
            el.setAttribute('type', isPassword ? 'text' : 'password');
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
        }

        // Live password validation
        const newPassEl = document.getElementById('newPass');
        const reqUpper = document.getElementById('reqUpper');
        const reqLength = document.getElementById('reqLength');
        const seg1 = document.getElementById('seg1');
        const seg2 = document.getElementById('seg2');
        const seg3 = document.getElementById('seg3');
        const seg4 = document.getElementById('seg4');

        newPassEl.addEventListener('input', function(e) {
            const val = e.target.value;
            const hasUpper = /[A-Z]/.test(val);
            const hasLen = val.length >= 6;
            const hasDigit = /\d/.test(val);
            const hasSpecial = /[^A-Za-z0-9]/.test(val);

            // Upper case indicator
            if (hasUpper) {
                reqUpper.className = "text-success";
                reqUpper.innerHTML = '<i class="bi bi-check-circle me-1"></i> At least one Upper case character';
            } else {
                reqUpper.className = "text-danger";
                reqUpper.innerHTML = '<i class="bi bi-x-circle me-1"></i> At least one Upper case character';
            }

            // Length indicator
            if (hasLen) {
                reqLength.className = "text-success";
                reqLength.innerHTML = '<i class="bi bi-check-circle me-1"></i> Minimum 6 characters';
            } else {
                reqLength.className = "text-danger";
                reqLength.innerHTML = '<i class="bi bi-x-circle me-1"></i> Minimum 6 characters';
            }

            // Segment meter
            let score = 0;
            if (val.length > 0) score++;
            if (hasLen && hasUpper) score++;
            if (hasDigit) score++;
            if (hasSpecial) score++;

            seg1.style.backgroundColor = score >= 1 ? '#009fe3' : '#e2e8f0';
            seg2.style.backgroundColor = score >= 2 ? '#009fe3' : '#e2e8f0';
            seg3.style.backgroundColor = score >= 3 ? '#009fe3' : '#e2e8f0';
            seg4.style.backgroundColor = score >= 4 ? '#009fe3' : '#e2e8f0';
        });
    </script>
}
