@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-5 rounded-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark">Access Restricted</h3>
                <p class="text-muted">
                    You do not have the required permissions to access this administrative page. Unauthorized URL changes or privilege escalations are logged for security.
                </p>
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">
                        <i class="bi bi-house me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
