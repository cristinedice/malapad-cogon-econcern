@model MalapadCogonEConcern.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account - Malapad Cogon e-Concern";
    Layout = null;
    var sitios = ViewBag.Sitios as List<MalapadCogonEConcern.Models.Entities.Sitio> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Cristine Dice" />
    <title>Create an Account - Barangay Malapad Cogon e-Concern</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/marikina-style.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>
    <div class="container pt-3 pt-md-4">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 text-center">
                <!-- Seal -->
                <div class="mb-2">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/malapad-cogon-seal.svg" alt="Barangay Malapad Cogon Seal" style="width: 85px; height: 85px;" />
                    </a>
                </div>

                <!-- Brand Title -->
                <h2 class="brand-title mb-2">
                    <span class="brand-blue-text d-block" style="font-size: 1.8rem; font-weight: 800; letter-spacing: -0.5px;">MALAPAD COGON</span>
                    <span class="brand-orange-text d-block" style="font-size: 1.7rem; font-weight: 700; margin-top: -6px;">e-Concern</span>
                </h2>

                <h4 class="fw-bold brand-blue-text mb-1" style="letter-spacing: 0.5px;">CREATE AN ACCOUNT</h4>
                <p class="text-muted small mb-4">
                    Already have an account? 
                    <a asp-action="Login" class="brand-blue-text fw-bold text-decoration-none">Sign In Here</a>
                </p>

                <!-- Registration Form -->
                <form asp-action="Register" method="post" class="text-start mx-auto" style="max-width: 440px;">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- Full Name -->
                    <div class="marikina-input-group">
                        <label asp-for="FullName">Full Name</label>
                        <i class="bi bi-person-badge marikina-input-icon"></i>
                        <input asp-for="FullName" class="marikina-input-field" placeholder="e.g. Cristine Dice" required autofocus />
                        <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Email -->
                    <div class="marikina-input-group">
                        <label asp-for="Email">Email Address</label>
                        <i class="bi bi-envelope marikina-input-icon"></i>
                        <input asp-for="Email" class="marikina-input-field" placeholder="example@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Mobile Phone -->
                    <div class="marikina-input-group">
                        <label asp-for="PhoneNumber">Mobile Number</label>
                        <i class="bi bi-phone marikina-input-icon"></i>
                        <input asp-for="PhoneNumber" class="marikina-input-field" placeholder="09XX-XXX-XXXX" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Sitio / Purok Selection -->
                    <div class="marikina-input-group">
                        <label asp-for="SitioId">Sitio / Purok (Malapad Cogon)</label>
                        <i class="bi bi-geo-alt marikina-input-icon"></i>
                        <select asp-for="SitioId" class="marikina-input-field" required>
                            <option value="">-- Pilia ang Purok o Sitio --</option>
                            @foreach (var s in sitios)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SitioId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Password -->
                    <div class="marikina-input-group">
                        <label asp-for="Password">Password</label>
                        <i class="bi bi-lock-fill marikina-input-icon"></i>
                        <input asp-for="Password" type="password" class="marikina-input-field" placeholder="Minimum 6 characters" required />
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="marikina-input-group">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <i class="bi bi-check-circle marikina-input-icon"></i>
                        <input asp-for="ConfirmPassword" type="password" class="marikina-input-field" placeholder="Re-enter password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-marikina-blue py-3 fs-6 shadow-sm">
                            Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bottom Wave Illustration -->
    <div class="bottom-wave-wrapper mt-3">
        <img src="~/images/community-wave-footer.svg" class="bottom-wave-img" alt="Community Wave Footer" />
        <div class="bottom-overlay-badge">
            <span class="text-alagang">Alagang</span>
            <span class="text-place">Malapad Cogon</span>
            <span class="text-unit">Barangay</span>
        </div>
    </div>

    <!-- Official Developer Ownership Sub-Footer -->
    <div class="py-2 text-center text-muted small bg-white border-top position-relative z-3" style="font-size: 0.8rem;">
        Barangay Malapad Cogon e-Concern &bull; System Designed &amp; Developed by <strong class="brand-blue-text">Cristine Dice</strong>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
