@using Microsoft.AspNetCore.Identity
@using MalapadCogonEConcern.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var initial = !string.IsNullOrEmpty(currentUser?.FullName) ? currentUser.FullName.Substring(0, 1).ToUpper() : "U";
    var firstName = !string.IsNullOrEmpty(currentUser?.FullName) ? currentUser.FullName.Split(' ')[0].ToUpper() : "USER";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Malapad Cogon e-Concern</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Marikina Style Theme -->
    <link rel="stylesheet" href="~/css/marikina-style.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Brand Navbar (Matching Images 3, 4, 5) -->
    <header class="marikina-navbar sticky-top shadow-sm">
        <div class="container-fluid px-lg-5">
            <div class="d-flex justify-content-between align-items-center">
                <!-- Brand Title Left -->
                <a asp-controller="Home" asp-action="@(SignInManager.IsSignedIn(User) ? "Dashboard" : "Index")" class="text-decoration-none d-flex align-items-center gap-2">
                    <img src="~/images/malapad-cogon-seal.svg" alt="Seal" style="width: 42px; height: 42px;" />
                    <div>
                        <div class="brand-blue-text fw-bold lh-1" style="font-size: 1.15rem; letter-spacing: -0.3px;">MALAPAD COGON</div>
                        <div class="brand-orange-text fw-bold lh-1" style="font-size: 1.05rem; margin-top: 1px;">e-Concern</div>
                    </div>
                </a>

                <!-- User Profile Right (Matching Images 3, 4, 5: "Hi, CRISTINE") -->
                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0" type="button" data-bs-toggle="dropdown">
                                <span class="avatar-badge">@initial</span>
                                <span class="fw-bold brand-blue-text fs-6 d-none d-sm-inline">Hi, @firstName</span>
                                <i class="bi bi-chevron-down brand-blue-text small"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@currentUser?.FullName</div>
                                    <small class="text-muted text-break">@currentUser?.Email</small>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Home" asp-action="Dashboard">
                                        <i class="bi bi-house-door-fill me-2 brand-blue-text"></i> Home Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Concern" asp-action="SelectCategory">
                                        <i class="bi bi-send-fill me-2 brand-orange-text"></i> Submit Concern
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Concern" asp-action="MyConcerns">
                                        <i class="bi bi-chat-dots-fill me-2 brand-blue-text"></i> My Concern
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-fill me-2 brand-blue-text"></i> Profile
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="px-3 py-1">
                                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Official Portal</small>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 brand-blue-text"></i> Admin Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Concerns">
                                            <i class="bi bi-card-checklist me-2 brand-blue-text"></i> All Concerns
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Reports" asp-action="Index">
                                            <i class="bi bi-file-earmark-bar-graph me-2 brand-blue-text"></i> Council Reports
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Settings" asp-action="Index">
                                                <i class="bi bi-sliders me-2 brand-blue-text"></i> Settings
                                            </a>
                                        </li>
                                    }
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-marikina-blue px-3 py-1">
                            Sign In
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Main View Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
