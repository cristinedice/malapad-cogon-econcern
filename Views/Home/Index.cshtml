@{
    ViewData["Title"] = "Barangay Malapad Cogon e-Concern";
    Layout = null; // Clean dedicated full-bleed landing page matching Image 1
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Cristine Dice" />
    <meta name="description" content="Official e-Concern Community Reporting System for Barangay Malapad, Cogon, Sigma, Capiz. Designed and Developed by Cristine Dice." />
    <title>Barangay Malapad Cogon e-Concern</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/marikina-style.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>
    <!-- Top Content Container -->
    <div class="container pt-4 pt-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <!-- Official Barangay Seal -->
                <div class="mb-3">
                    <img src="~/images/malapad-cogon-seal.svg" alt="Barangay Malapad Cogon Seal" style="width: 105px; height: 105px;" />
                </div>

                <!-- Brand Title (Blue / Orange) -->
                <h1 class="brand-title mb-3">
                    <span class="brand-blue-text d-block" style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.5px;">MALAPAD COGON</span>
                    <span class="brand-orange-text d-block" style="font-size: 2.1rem; font-weight: 700; margin-top: -6px;">e-Concern</span>
                </h1>

                <!-- Tagline -->
                <p class="text-secondary mx-auto mb-4" style="max-width: 580px; font-size: 1.05rem; line-height: 1.5; font-weight: 500;">
                    Sa Alagang Malapad Cogon, may nakikinig at tumutugon.<br>
                    Gamitin ang E-Concern upang maiparating ang inyong mensahe sa kinauukulan—mabilis, madali, at may malasakit.
                </p>

                <!-- Click Here to Login Button -->
                <div class="mx-auto mb-3" style="max-width: 420px;">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-marikina-blue w-100 py-3 fs-6 d-block shadow-sm">
                        Click here to login
                    </a>
                </div>

                <!-- Create an account Link -->
                <div class="mb-4">
                    <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold brand-blue-text fs-6">
                        Create an account
                    </a>
                </div>

                <!-- Fast Track Reference without Account -->
                <div class="mb-4">
                    <a asp-controller="Concern" asp-action="Track" class="small text-muted text-decoration-none border px-3 py-1 rounded-pill bg-light">
                        <i class="bi bi-search me-1 text-primary"></i> May Reference Number na? I-check ang Status dito
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Silhouette Wave with Alagang Malapad Cogon Badge -->
    <div class="bottom-wave-wrapper">
        <img src="~/images/community-wave-footer.svg" class="bottom-wave-img" alt="Community Wave Footer" />
        <div class="bottom-overlay-badge">
            <span class="text-alagang">Alagang</span>
            <span class="text-place">Malapad Cogon</span>
            <span class="text-unit">Barangay</span>
        </div>
    </div>

    <!-- Official Developer Ownership Sub-Footer -->
    <div class="py-2 text-center text-muted small bg-white border-top position-relative z-3" style="font-size: 0.82rem;">
        &copy; @DateTime.UtcNow.Year Barangay Malapad Cogon &bull; System Designed &amp; Developed by <strong class="brand-blue-text">Cristine Dice</strong>
        <a href="#" class="text-decoration-none ms-2 badge bg-light brand-blue-text border" data-bs-toggle="modal" data-bs-target="#aboutDeveloperModal">
            <i class="bi bi-info-circle me-1"></i> Developer Info
        </a>
    </div>

    <!-- Modal: About System & Developer Ownership -->
    <div class="modal fade" id="aboutDeveloperModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold brand-blue-text">
                        <i class="bi bi-shield-check me-2"></i> System &amp; Developer Profile
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <img src="~/images/malapad-cogon-seal.svg" alt="Seal" style="width: 72px; height: 72px;" class="mb-2" />
                        <h5 class="fw-bold brand-blue-text mb-0">Malapad Cogon e-Concern</h5>
                        <small class="text-muted">Community Reporting &amp; Incident Tracking Platform</small>
                        <div class="mt-2">
                            <span class="badge bg-light brand-blue-text border px-3 py-1">Version 1.0 (2026 Edition)</span>
                        </div>
                    </div>

                    <!-- Developer Ownership Card -->
                    <div class="card border-0 rounded-4 p-3 mb-3 shadow-sm text-start" style="background: linear-gradient(135deg, #f1f7fc 0%, #e8f3fa 100%); border-left: 5px solid #0b5791 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; background-color: #0b5791; font-weight: 800; font-size: 1.25rem;">
                                CD
                            </div>
                            <div>
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Lead Software Architect &amp; Developer</small>
                                <h5 class="fw-bold brand-blue-text mb-0">Cristine Dice</h5>
                                <small class="text-secondary fw-semibold">Systems Developer &bull; Project Author &amp; Owner</small>
                            </div>
                        </div>
                    </div>

                    <p class="small text-muted mb-3 text-start" style="line-height: 1.5;">
                        This digital system was custom-designed and engineered by <strong>Cristine Dice</strong> for <strong>Barangay Malapad, Cogon, Municipality of Sigma, Capiz</strong> to streamline public service delivery, community grievance recording, and council analytics.
                    </p>

                    <div class="p-3 bg-light rounded-3 small border text-start">
                        <div class="row g-2">
                            <div class="col-6"><strong>Backend:</strong> ASP.NET Core (.NET 8)</div>
                            <div class="col-6"><strong>Frontend:</strong> Responsive MVC &amp; Bootstrap</div>
                            <div class="col-6"><strong>Database:</strong> SQLite / EF Core 8</div>
                            <div class="col-6"><strong>Security:</strong> RA 10173 Compliant</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-marikina-blue px-4" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
