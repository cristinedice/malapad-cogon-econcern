@model MalapadCogonEConcern.ViewModels.ConcernTrackViewModel
@{
    ViewData["Title"] = "Track Concern Status - I-check ang Reklamo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #0d3813 0%, #1b5e20 100%);">
                    <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width: 58px; height: 58px;">
                        <i class="bi bi-search fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-1">I-check ang Status sang Reklamo</h4>
                    <small class="text-white-50">Barangay Malapad, Cogon, Sigma, Capiz</small>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-octagon fs-5 flex-shrink-0"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }

                    <p class="small text-muted mb-4 text-center">
                        Isulod ang imo <strong>Reference Number</strong> kag ang <strong>4-Digit PIN</strong> nga imo ginhimo sang nagsumite ka.
                    </p>

                    <form asp-action="Track" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="ReferenceNumber" class="form-label small fw-bold text-dark"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light font-monospace"><i class="bi bi-hash"></i></span>
                                <input asp-for="ReferenceNumber" class="form-control font-monospace" placeholder="MC-2026-0001" required autofocus />
                            </div>
                            <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="VerificationPin" class="form-label small fw-bold text-dark"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                <input asp-for="VerificationPin" class="form-control" maxlength="4" placeholder="4-digit secret PIN" required />
                            </div>
                            <span asp-validation-for="VerificationPin" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Ginaprotektahan sini ang imo privacy agud ikaw lamang ang makalantaw.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success py-3 fw-bold shadow-sm">
                                <i class="bi bi-search me-1"></i> I-check ang Reklamo (Track)
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light text-muted small">
                                Magbalik sa Home Page
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3 border-0 small text-muted">
                    Nalipatan ang Reference Number ukon PIN? <br>
                    Magbisita sa Barangay Hall para sa manual nga pagpangusisa.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
