@model MalapadCogonEConcern.ViewModels.ConcernSubmitViewModel
@{
    ViewData["Title"] = "Submit a Concern - Magsumite sang Reklamo";
    var categories = ViewBag.Categories as List<MalapadCogonEConcern.Models.Entities.Category> ?? new();
    var sitios = ViewBag.Sitios as List<MalapadCogonEConcern.Models.Entities.Sitio> ?? new();
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="p-4 text-white" style="background: linear-gradient(135deg, #0d3813 0%, #1b5e20 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning text-dark rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Form sa Pagsumite sang Reklamo</h4>
                            <small class="text-white-50">Barangay Malapad, Cogon, Sigma, Capiz</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <!-- Scope Reminder -->
                    <div class="alert alert-light border d-flex align-items-start gap-2 small text-muted mb-4">
                        <i class="bi bi-info-circle text-success fs-5 flex-shrink-0"></i>
                        <div>
                            Palihog siguroha nga ang imo reklamo may kaangtanan sa pampubliko nga mga serbisyo kag pasilidad (karsada, suga, kanal, basura, agrikultura, etc.). Ang mga personal nga alitan ginadala direkta sa Lupon Tagapamayapa sa Barangay Hall.
                        </div>
                    </div>

                    <form asp-action="Submit" method="post" enctype="multipart/form-data" id="submitForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- 1. Category & Sitio -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold text-dark small"></label>
                                <span class="text-danger">*</span>
                                <select asp-for="CategoryId" class="form-select" required>
                                    <option value="">-- Pilia ang Kategorya --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SitioId" class="form-label fw-bold text-dark small"></label>
                                <span class="text-danger">*</span>
                                <select asp-for="SitioId" class="form-select" required>
                                    <option value="">-- Pilia ang Purok o Sitio --</option>
                                    @foreach (var s in sitios)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="SitioId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 2. Landmark or Specific Address -->
                        <div class="mb-3">
                            <label asp-for="LandmarkOrAddress" class="form-label fw-bold text-dark small"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="LandmarkOrAddress" class="form-control" placeholder="Halimbawa: Lapit sa tindahan ni Kap / Atubang sang tulay" required />
                            </div>
                            <span asp-validation-for="LandmarkOrAddress" class="text-danger small"></span>
                        </div>

                        <!-- 3. Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold text-dark small"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Title" class="form-control" placeholder="Hal: Naguba nga poste sang suga / Barado nga kanal" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- 4. Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold text-dark small"></label>
                            <span class="text-danger">*</span>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Ipaathag sing maayo ang sitwasyon, ano ang nagakatabo, kag ano ang kinahanglan aksyunan sang barangay..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- 5. Photo Upload -->
                        <div class="mb-4">
                            <label asp-for="PhotoAttachment" class="form-label fw-bold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="PhotoAttachment" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" id="photoInput" />
                                <span class="input-group-text"><i class="bi bi-camera"></i></span>
                            </div>
                            <small class="text-muted d-block mt-1">Ginasuportahan: JPG, PNG, WEBP (Maximum 5MB). Opsyonal apang makabulig sa madasig nga pag-imbestiga.</small>
                            <span asp-validation-for="PhotoAttachment" class="text-danger small"></span>

                            <!-- Preview container -->
                            <div id="imagePreviewContainer" class="mt-2 d-none">
                                <img id="imagePreview" src="#" alt="Photo Preview" class="img-thumbnail rounded-3" style="max-height: 200px;" />
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- 6. Complainant Info (Optional & Confidential) -->
                        <h6 class="fw-bold text-success mb-2">
                            <i class="bi bi-person-badge me-1"></i> Impormasyon sang Nagasumite (Opsyonal &amp; Kompidensyal)
                        </h6>
                        <p class="small text-muted mb-3">
                            Indi ini ipagwa sa publiko nga tracking page. Ginagamit lamang ini agud makontak ka sang opisyal kon kinahanglan sang dugang nga detalye.
                        </p>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ComplainantName" class="form-label small fw-semibold text-muted"></label>
                                <input asp-for="ComplainantName" class="form-control form-control-sm" placeholder="Juan Dela Cruz (Opsyonal)" />
                                <span asp-validation-for="ComplainantName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ComplainantContact" class="form-label small fw-semibold text-muted"></label>
                                <input asp-for="ComplainantContact" class="form-control form-control-sm" placeholder="09XX-XXX-XXXX (Opsyonal)" />
                                <span asp-validation-for="ComplainantContact" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- 7. 4-Digit Security PIN -->
                        <h6 class="fw-bold text-success mb-2">
                            <i class="bi bi-shield-lock me-1"></i> Proteksyon sang Imo Report (4-Digit Secret PIN)
                        </h6>
                        <p class="small text-muted mb-3">
                            Maghimo sang 4-digit nga numero (halimbawa: <code>1234</code> ukon <code>7890</code>). Gamiton mo ini upod sa Reference Number agud ikaw lamang ang makalantaw sang detalye sang imo reklamo.
                        </p>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="VerificationPin" class="form-label fw-bold text-dark small"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="VerificationPin" class="form-control" maxlength="4" placeholder="4 digits (e.g. 2026)" required />
                                <span asp-validation-for="VerificationPin" class="text-danger small"></span>
                            </div>

                            <div class="col-sm-6">
                                <label asp-for="ConfirmPin" class="form-label fw-bold text-dark small"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="ConfirmPin" class="form-control" maxlength="4" placeholder="Isulat liwat ang 4-digit PIN" required />
                                <span asp-validation-for="ConfirmPin" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 8. Privacy Consent -->
                        <div class="form-check p-3 bg-light rounded-3 mb-4 border">
                            <input asp-for="PrivacyConsent" class="form-check-input ms-0 me-2" type="checkbox" id="privacyConsent" required>
                            <label class="form-check-label small text-dark" for="privacyConsent">
                                <strong>Pahayag sang Pagpasugot (Data Privacy):</strong> Nagapasugot ako nga ang mga impormasyon nga akon ginsulat diri pagagamiton sang Barangay Malapad Cogon para lamang sa katuyuan sang pag-aksyon kag pagresolba sang sini nga reklamo sandig sa Data Privacy Act of 2012 (RA 10173).
                            </label>
                            <span asp-validation-for="PrivacyConsent" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold shadow-sm" id="btnSubmit">
                                <i class="bi bi-send me-1"></i> Ipadala ang Reklamo (Submit Concern)
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light text-muted">
                                Kanselahon kag Magbalik sa Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Photo preview script
        document.getElementById('photoInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const container = document.getElementById('imagePreviewContainer');
            const preview = document.getElementById('imagePreview');
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    preview.src = event.target.result;
                    container.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                container.classList.add('d-none');
            }
        });

        // Prevent double submit
        document.getElementById('submitForm').addEventListener('submit', function() {
            if ($(this).valid()) {
                const btn = document.getElementById('btnSubmit');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Ginapadala...';
            }
        });
    </script>
}
